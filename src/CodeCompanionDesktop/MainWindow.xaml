<Window x:Class="CodeCompanionDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Code Companion Desktop"
        Width="760"
        Height="760"
        ResizeMode="CanMinimize"
        Icon="Assets/app.png"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceAltBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="54"
                        Height="54"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Image Source="Assets/app.png"
                           Width="40"
                           Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Code Companion Desktop"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Desktop voice playback service"
                               Margin="0,6,0,0"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="0,18,0,20">
            <TabItem Header="Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,14,0,0">
                    <StackPanel>
                        <Border Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46"
                                        Height="46"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Background="{StaticResource AppSurfaceAltBrush}">
                                    <TextBlock x:Name="ReadinessIconText"
                                               Text="?"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="14,0,0,0">
                                    <TextBlock x:Name="ReadinessSummaryText"
                                               Text="Checking Code Companion status..."
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="ReadinessDetailsText"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Status"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="StatusText"
                                           Margin="0,8,0,0"
                                           Text="Ready. Tray icon is active."
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AudioPathText"
                                           Margin="0,12,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="QuotaMeterCompactCard"
                                Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="ElevenLabs Quota"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="QuotaCompactSummaryText"
                                           Margin="0,8,0,0"
                                           Text="Save an ElevenLabs API key to see remaining characters."
                                           TextWrapping="Wrap" />
                                <ProgressBar x:Name="QuotaCompactProgressBar"
                                             Margin="0,10,0,0"
                                             Height="8"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="QuotaCompactDetailText"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Deliberately its own card, not inside QuotaMeterCompactCard.
                             That card starts collapsed and is revealed by
                             ApplyQuotaCardVisibility once the quota resolves; a PlotView
                             given its model while its host has no layout size renders
                             against stale bounds and never re-renders, which showed up
                             as a chart clipped on the left and top with no error. -->
                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Daily Usage"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <oxy:PlotView x:Name="QuotaUsagePlot"
                                              Height="180"
                                              Margin="0,10,0,0"
                                              Background="Transparent"
                                              Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Speech Profile"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Demo Mode makes Codex speak more often for the current Desktop session."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="SpeechProfileStatusText"
                                           Margin="0,8,0,0"
                                           Text="Speech profile: Standard"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="EndDemoModeButton"
                                            MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="End Demo"
                                            Click="EndDemoModeButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Startup"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Controls whether Code Companion Desktop is ready before VS Code opens."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <CheckBox x:Name="StartHiddenToTrayCheckBox"
                                          Margin="0,10,0,0"
                                          Content="Start hidden to tray"
                                          Checked="StartHiddenToTrayCheckBox_Changed"
                                          Unchecked="StartHiddenToTrayCheckBox_Changed" />
                                <CheckBox x:Name="StartWithWindowsCheckBox"
                                          Margin="0,10,0,0"
                                          Content="Start with Windows sign-in"
                                          Checked="StartWithWindowsCheckBox_Changed"
                                          Unchecked="StartWithWindowsCheckBox_Changed" />
                                <TextBlock x:Name="SettingsStatusText"
                                           Margin="0,10,0,0"
                                           Text="Startup preference loaded."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Speech Provider"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Provider"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <ComboBox x:Name="SpeechProviderComboBox"
                                          Height="32"
                                          Margin="0,4,0,0">
                                    <ComboBoxItem Content="ElevenLabs" />
                                </ComboBox>
                                <TextBlock Text="ElevenLabs voice ID"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ElevenLabsVoiceIdTextBox"
                                         Height="32"
                                         Margin="0,4,0,0" />
                                <TextBlock Text="ElevenLabs model ID"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ElevenLabsModelIdTextBox"
                                         Height="32"
                                         Margin="0,4,0,0" />
                                <TextBlock Text="ElevenLabs output format"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ElevenLabsOutputFormatTextBox"
                                         Height="32"
                                         Margin="0,4,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button MinWidth="156"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Save Provider"
                                            Click="SaveProviderSettingsButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="ProviderSettingsStatusText"
                                           Text="Provider settings loaded."
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="ElevenLabs API Key"
                                           Margin="0,16,0,0"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <PasswordBox x:Name="ElevenLabsApiKeyBox"
                                             Margin="0,10,0,0"
                                             Height="32" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button MinWidth="108"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Save Key"
                                            Click="SaveApiKeyButton_Click" />
                                    <Button MinWidth="108"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Load Key"
                                            Click="LoadApiKeyButton_Click" />
                                    <Button MinWidth="108"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Clear Key"
                                            Click="ClearApiKeyButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="CredentialStatusText"
                                           Text="No key loaded."
                                           Style="{StaticResource MutedTextStyle}" />

                                <TextBlock Text="Quota Details"
                                           Margin="0,16,0,0"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:Name="QuotaDetailSubtitleText"
                                           Text="Live ElevenLabs character usage for the current billing period."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="QuotaDetailTierText"
                                           Margin="0,10,0,0"
                                           Text="Tier: unknown" />
                                <TextBlock x:Name="QuotaDetailCharactersText"
                                           Margin="0,4,0,0"
                                           Text="Used: -" />
                                <TextBlock x:Name="QuotaDetailRemainingText"
                                           Margin="0,4,0,0"
                                           Text="Remaining: -" />
                                <TextBlock x:Name="QuotaDetailResetText"
                                           Margin="0,4,0,0"
                                           Text="Resets: -" />
                                <TextBlock x:Name="QuotaDetailAsOfText"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="No data yet." />
                                <TextBlock x:Name="QuotaDetailStatusText"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" />
                                <CheckBox x:Name="ShowQuotaMeterCheckBox"
                                          Margin="0,10,0,0"
                                          Content="Show quota meter on Status tab"
                                          Checked="ShowQuotaMeterCheckBox_Changed"
                                          Unchecked="ShowQuotaMeterCheckBox_Changed" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="RefreshQuotaButton"
                                            MinWidth="156"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Refresh Quota"
                                            Click="RefreshQuotaButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Client Pairing"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Approves VS Code clients so they can send speech candidates to Desktop."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Refresh"
                                            Click="RefreshClientPairingButton_Click" />
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Copy"
                                            Click="CopyClientPairingButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="Client ID"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ClientPairingClientIdTextBox"
                                         Height="32"
                                         Margin="0,4,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button MinWidth="154"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Approve Pending"
                                            Click="ApprovePendingClientPairingButton_Click" />
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Approve"
                                            Click="ApproveClientPairingButton_Click" />
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Deny"
                                            Click="DenyClientPairingButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="ClientPairingStatusText"
                                           Text="Client pairing loaded."
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ClientPairingTextBox"
                                         Margin="0,12,0,0"
                                         MinHeight="132"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Local Bridge"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="The local bridge receives approved speech requests from Code Companion Voice."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="BridgeStatusText"
                                           Margin="0,8,0,0"
                                           Text="Bridge starting..."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Speech Behavior"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <CheckBox x:Name="QueueBridgeSpeechCheckBox"
                                          Margin="0,10,0,0"
                                          Content="Queue bridge speech requests"
                                          Checked="QueueBridgeSpeechCheckBox_Changed"
                                          Unchecked="QueueBridgeSpeechCheckBox_Changed" />
                                <StackPanel Margin="0,10,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="Queue limit"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <ComboBox x:Name="MaxBridgeQueueComboBox"
                                              Width="72"
                                              Height="32"
                                              Margin="12,0,0,0"
                                              SelectionChanged="MaxBridgeQueueComboBox_SelectionChanged">
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="5" />
                                        <ComboBoxItem Content="10" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="SelfTestPlaybackCheckBox"
                                          Margin="0,10,0,0"
                                          Content="Speak pipeline self-test phrases"
                                          Checked="SelfTestPlaybackCheckBox_Changed"
                                          Unchecked="SelfTestPlaybackCheckBox_Changed" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="When off, a Run Pipeline Self-Test still runs the full pipeline and is logged in Speech History, but is not spoken aloud."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Refresh Status"
                                            Click="RefreshBridgeStatusButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,14,0,0">
                    <StackPanel>
                        <Border Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <TextBlock Text="This section is for development and troubleshooting. You usually do not need to change anything here."
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Speech Diagnostics"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Shows current-session bridge, provider, playback, and policy details."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Refresh"
                                            Click="RefreshSpeechDiagnosticsButton_Click" />
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Copy"
                                            Click="CopySpeechDiagnosticsButton_Click" />
                                </WrapPanel>
                                <TextBox x:Name="SpeechDiagnosticsTextBox"
                                         MinHeight="156"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Project Registry"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Tracks known Code Companion projects and their Windows/WSL path aliases so speech history and diagnostics can be grouped correctly."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Refresh"
                                            Click="RefreshProjectRegistryButton_Click" />
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Copy"
                                            Click="CopyProjectRegistryButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="Project ID"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ProjectAliasProjectIdTextBox"
                                         Height="32"
                                         Margin="0,4,0,0" />
                                <TextBlock Text="Root alias"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ProjectAliasRootTextBox"
                                         Height="32"
                                         Margin="0,4,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Add Alias"
                                            Click="AddProjectAliasButton_Click" />
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Remove Alias"
                                            Click="RemoveProjectAliasButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="ProjectRegistryStatusText"
                                           Text="Project registry loaded."
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBox x:Name="ProjectRegistryTextBox"
                                         Margin="0,12,0,0"
                                         MinHeight="156"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Project Speech History"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Shows recent speech decisions grouped by project for troubleshooting."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Refresh"
                                            Click="RefreshProjectSpeechHistoryButton_Click" />
                                    <Button MinWidth="128"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Copy"
                                            Click="CopyProjectSpeechHistoryButton_Click" />
                                </WrapPanel>
                                <TextBox x:Name="ProjectSpeechHistoryTextBox"
                                         MinHeight="156"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="18"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Startup Diagnostics"
                                           Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Shows the Windows Run registration and executable path used for sign-in startup."
                                           Margin="0,6,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button MinWidth="154"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Refresh Diagnostics"
                                            Click="RefreshStartupDiagnosticsButton_Click" />
                                    <Button MinWidth="154"
                                            Height="32"
                                            Margin="0,0,10,10"
                                            Content="Copy Diagnostics"
                                            Click="CopyStartupDiagnosticsButton_Click" />
                                </WrapPanel>
                                <TextBox x:Name="StartupDiagnosticsTextBox"
                                         MinHeight="108"
                                         Padding="8"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notes">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,14,0,0">
                    <Border Padding="18"
                            Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Setup Notes"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="1. Start Code Companion Desktop. Keep it running or hidden to tray while using VS Code." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="2. Save your ElevenLabs provider settings and API key in the Speech Provider section." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="3. Enable Start with Windows sign-in and Start hidden to tray if you want Desktop ready before VS Code opens." />
                            <TextBlock Margin="0,18,0,0"
                                       Text="VS Code Extension Setup"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="4. Install Code Companion Voice separately in VS Code. During local development, get the VSIX from D:\Development\CodeCompanionVoice after running npm run package:vsix in that repository." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="5. Install the VSIX with Extensions: Install from VSIX in VS Code, or run code.cmd --install-extension D:\Development\CodeCompanionVoice\code-companion-voice-&lt;version&gt;.vsix --force from PowerShell." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="6. Windows VS Code and WSL Remote use separate extension hosts. Install Code Companion Voice into each host you use." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="7. The production install source is the VS Code Marketplace once publication is complete. Until then, use the local VSIX." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="8. Run Code Companion Voice: Send Desktop Candidate Test from VS Code." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="9. If Desktop shows a pending VS Code client, use Client Pairing > Approve Pending, then run the Desktop Candidate Test again." />
                            <TextBlock Margin="0,18,0,0"
                                       Text="What The Main Controls Do"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Status shows whether Desktop is ready to speak and lists the next fix when something is missing." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Speech Provider stores provider configuration and the API key in Windows Credential Manager." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Client Pairing approves VS Code clients so they can send speech candidates to Desktop." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Local Bridge shows the local Desktop service endpoint used by Code Companion Voice." />
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Advanced contains development and troubleshooting diagnostics. You usually do not need it for daily use." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <WrapPanel Grid.Row="2">
            <Button x:Name="PlayButton"
                    MinWidth="124"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Play WAV Test"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="PlayButton_Click" />
            <Button x:Name="PlayElevenLabsButton"
                    MinWidth="154"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Play ElevenLabs Test"
                    Click="PlayElevenLabsButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Hide to Tray"
                    Click="HideButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Content="Exit"
                    Click="ExitButton_Click" />
        </WrapPanel>
    </Grid>
</Window>
