<Window x:Class="CodeCompanionDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Companion Desktop"
        Width="640"
        Height="680"
        MinWidth="420"
        MinHeight="520"
        Icon="Assets/app.png"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceAltBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="54"
                        Height="54"
                        Background="{StaticResource AppSurfaceBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Image Source="Assets/app.png"
                           Width="40"
                           Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Code Companion Desktop"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Desktop voice playback service"
                               Margin="0,6,0,0"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,20"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="18"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,8,0,0"
                                   Text="Ready. Tray icon is active."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="AudioPathText"
                                   Margin="0,12,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Speech Provider"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Provider"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <ComboBox x:Name="SpeechProviderComboBox"
                                  Height="32"
                                  Margin="0,4,0,0">
                            <ComboBoxItem Content="ElevenLabs" />
                        </ComboBox>
                        <TextBlock Text="ElevenLabs voice ID"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBox x:Name="ElevenLabsVoiceIdTextBox"
                                 Height="32"
                                 Margin="0,4,0,0" />
                        <TextBlock Text="ElevenLabs model ID"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBox x:Name="ElevenLabsModelIdTextBox"
                                 Height="32"
                                 Margin="0,4,0,0" />
                        <TextBlock Text="ElevenLabs output format"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBox x:Name="ElevenLabsOutputFormatTextBox"
                                 Height="32"
                                 Margin="0,4,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button MinWidth="156"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Save Provider"
                                    Click="SaveProviderSettingsButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="ProviderSettingsStatusText"
                                   Text="Provider settings loaded."
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="ElevenLabs API Key"
                                   Margin="0,16,0,0"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <PasswordBox x:Name="ElevenLabsApiKeyBox"
                                     Margin="0,10,0,0"
                                     Height="32" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button MinWidth="108"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Save Key"
                                    Click="SaveApiKeyButton_Click" />
                            <Button MinWidth="108"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Load Key"
                                    Click="LoadApiKeyButton_Click" />
                            <Button MinWidth="108"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Clear Key"
                                    Click="ClearApiKeyButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="CredentialStatusText"
                                   Text="No key loaded."
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Speech Diagnostics"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button MinWidth="128"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Refresh"
                                    Click="RefreshSpeechDiagnosticsButton_Click" />
                            <Button MinWidth="128"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Copy"
                                    Click="CopySpeechDiagnosticsButton_Click" />
                        </WrapPanel>
                        <TextBox x:Name="SpeechDiagnosticsTextBox"
                                 Margin="0,0,0,0"
                                 MinHeight="156"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Project Registry"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button MinWidth="128"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Refresh"
                                    Click="RefreshProjectRegistryButton_Click" />
                            <Button MinWidth="128"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Copy"
                                    Click="CopyProjectRegistryButton_Click" />
                        </WrapPanel>
                        <TextBox x:Name="ProjectRegistryTextBox"
                                 Margin="0,0,0,0"
                                 MinHeight="156"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Local Bridge"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="BridgeStatusText"
                                   Margin="0,8,0,0"
                                   Text="Bridge starting..."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Speech Behavior"
                                   Margin="0,14,0,0"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <CheckBox x:Name="QueueBridgeSpeechCheckBox"
                                  Margin="0,10,0,0"
                                  Content="Queue bridge speech requests"
                                  Checked="QueueBridgeSpeechCheckBox_Changed"
                                  Unchecked="QueueBridgeSpeechCheckBox_Changed" />
                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Text="Queue limit"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}" />
                            <ComboBox x:Name="MaxBridgeQueueComboBox"
                                      Width="72"
                                      Height="32"
                                      Margin="12,0,0,0"
                                      SelectionChanged="MaxBridgeQueueComboBox_SelectionChanged">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="10" />
                            </ComboBox>
                        </StackPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button MinWidth="128"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Copy Token"
                                    Click="CopyBridgeTokenButton_Click" />
                            <Button MinWidth="128"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Refresh Status"
                                    Click="RefreshBridgeStatusButton_Click" />
                        </WrapPanel>
                        <TextBlock Text="Use this token only with the local VS Code extension bridge."
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Startup"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <CheckBox x:Name="StartHiddenToTrayCheckBox"
                                  Margin="0,10,0,0"
                                  Content="Start hidden to tray"
                                  Checked="StartHiddenToTrayCheckBox_Changed"
                                  Unchecked="StartHiddenToTrayCheckBox_Changed" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Margin="0,10,0,0"
                                  Content="Start with Windows sign-in"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed" />
                        <TextBlock x:Name="SettingsStatusText"
                                   Margin="0,10,0,0"
                                   Text="Startup preference loaded."
                                   Style="{StaticResource MutedTextStyle}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button MinWidth="154"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Refresh Diagnostics"
                                    Click="RefreshStartupDiagnosticsButton_Click" />
                            <Button MinWidth="154"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Copy Diagnostics"
                                    Click="CopyStartupDiagnosticsButton_Click" />
                        </WrapPanel>
                        <TextBlock Text="Startup Diagnostics"
                                   Margin="0,2,0,0"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBox x:Name="StartupDiagnosticsTextBox"
                                 Margin="0,8,0,0"
                                 MinHeight="108"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2">
            <Button x:Name="PlayButton"
                    MinWidth="124"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Play WAV Test"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="PlayButton_Click" />
            <Button x:Name="PlayElevenLabsButton"
                    MinWidth="154"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Play ElevenLabs Test"
                    Click="PlayElevenLabsButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Hide to Tray"
                    Click="HideButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Content="Exit"
                    Click="ExitButton_Click" />
        </WrapPanel>
    </Grid>
</Window>
