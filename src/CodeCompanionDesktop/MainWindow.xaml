<Window x:Class="CodeCompanionDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Companion Desktop"
        Width="560"
        Height="540"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Code Companion Desktop"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Desktop voice playback service"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,28,0,24"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="18"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,8,0,0"
                                   Text="Ready. Tray icon is active."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="AudioPathText"
                                   Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="ElevenLabs API Key"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="ElevenLabsApiKeyBox"
                                     Margin="0,10,0,0"
                                     Height="32" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button MinWidth="108"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Save Key"
                                    Click="SaveApiKeyButton_Click" />
                            <Button MinWidth="108"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Load Key"
                                    Click="LoadApiKeyButton_Click" />
                            <Button MinWidth="108"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Clear Key"
                                    Click="ClearApiKeyButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="CredentialStatusText"
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Text="No key loaded."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Local Bridge"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="BridgeStatusText"
                                   Margin="0,8,0,0"
                                   Text="Bridge starting..."
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button MinWidth="128"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Content="Copy Token"
                                    Click="CopyBridgeTokenButton_Click" />
                        </WrapPanel>
                        <TextBlock Text="Use this token only with the local VS Code extension bridge."
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2">
            <Button x:Name="PlayButton"
                    MinWidth="124"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Play WAV Test"
                    Click="PlayButton_Click" />
            <Button x:Name="PlayElevenLabsButton"
                    MinWidth="154"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Play ElevenLabs Test"
                    Click="PlayElevenLabsButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Hide"
                    Click="HideButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Content="Exit"
                    Click="ExitButton_Click" />
        </WrapPanel>
    </Grid>
</Window>
