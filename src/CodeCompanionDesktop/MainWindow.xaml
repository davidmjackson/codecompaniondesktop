<Window x:Class="CodeCompanionDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Companion Desktop"
        Width="520"
        Height="440"
        MinWidth="420"
        MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Code Companion Desktop"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Desktop voice playback service"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,28,0,24"
                Padding="18"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Status"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           Text="Ready. Tray icon is active."
                           TextWrapping="Wrap" />
                <TextBlock x:Name="AudioPathText"
                           Margin="0,12,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,24"
                Padding="18"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="ElevenLabs API Key"
                           FontWeight="SemiBold" />
                <PasswordBox x:Name="ElevenLabsApiKeyBox"
                             Margin="0,10,0,0"
                             Height="32" />
                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <Button MinWidth="88"
                            Height="32"
                            Margin="0,0,10,0"
                            Content="Save"
                            Click="SaveApiKeyButton_Click" />
                    <Button MinWidth="88"
                            Height="32"
                            Margin="0,0,10,0"
                            Content="Load"
                            Click="LoadApiKeyButton_Click" />
                    <Button MinWidth="88"
                            Height="32"
                            Content="Clear"
                            Click="ClearApiKeyButton_Click" />
                </DockPanel>
                <TextBlock x:Name="CredentialStatusText"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="No key loaded."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="PlayButton"
                    MinWidth="132"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Play Test Sound"
                    Click="PlayButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Margin="0,0,10,0"
                    Content="Hide"
                    Click="HideButton_Click" />
            <Button MinWidth="96"
                    Height="36"
                    Content="Exit"
                    Click="ExitButton_Click" />
        </DockPanel>
    </Grid>
</Window>
